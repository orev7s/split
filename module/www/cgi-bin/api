#!/system/bin/sh
# Split web API. BusyBox httpd CGI. GET only.

DIR=/data/adb/split
CONF=$DIR/config.tsv
ENABLED=$DIR/enabled
CTL=$DIR/splitctl

# Self-heal: after a hot reinstall $DIR may be gone while the engine still
# exists inside the module directory. Redeploy it before answering.
if [ ! -x "$CTL" ]; then
  for c in /data/adb/modules/split/bin/splitctl /data/adb/modules_update/split/bin/splitctl; do
    if [ -x "$c" ]; then
      mkdir -p "$DIR" 2>/dev/null
      cp -f "$c" "$CTL" 2>/dev/null && chmod 0755 "$CTL" 2>/dev/null
      break
    fi
  done
fi

printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

# JSON-safe one-liner for command output
clean() { printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/"/\\"/g'; }

cmd=""; pkg=""; mode=""
oldIFS=$IFS
IFS='&'
for kv in $QUERY_STRING; do
  k=${kv%%=*}
  v=${kv#*=}
  case "$k" in
    cmd)  cmd="$v" ;;
    pkg)  pkg="$v" ;;
    mode) mode="$v" ;;
  esac
done
IFS=$oldIFS

[ -f "$CONF" ] || : > "$CONF"

case "$cmd" in

  state)
    e=$(cat "$ENABLED" 2>/dev/null); [ -n "$e" ] || e=1
    rules=$(awk -F'\t' 'NF>=2 && $1 !~ /^#/ {
        gsub(/[^A-Za-z0-9._]/,"",$1); gsub(/[^a-z]/,"",$2);
        if ($1 != "") printf "%s{\"p\":\"%s\",\"m\":\"%s\"}", (n++ ? "," : ""), $1, $2
      }' "$CONF" 2>/dev/null)
    printf '{"enabled":%s,"rules":[%s]}\n' "$e" "$rules"
    ;;

  apps)
    list=$(pm list packages 2>/dev/null | sed 's/^package://' \
      | awk '{printf "%s\"%s\"", (n++ ? "," : ""), $0}')
    printf '{"apps":[%s]}\n' "$list"
    ;;

  set)
    if [ -z "$pkg" ]; then printf '{"ok":false,"err":"no package"}\n'; exit 0; fi
    case "$pkg" in *[!A-Za-z0-9._]*) printf '{"ok":false,"err":"bad package"}\n'; exit 0 ;; esac
    case "$mode" in allow|ignore) ;; *) printf '{"ok":false,"err":"bad mode"}\n'; exit 0 ;; esac
    out=$("$CTL" set "$pkg" "$mode" 2>&1); rc=$?
    if [ $rc -eq 0 ]; then ok=true; else ok=false; fi
    printf '{"ok":%s,"code":%s,"result":"%s"}\n' "$ok" "$rc" "$(clean "$out")"
    ;;

  enable)
    out=$("$CTL" enable 2>&1); rc=$?
    if [ $rc -eq 0 ]; then ok=true; else ok=false; fi
    printf '{"ok":%s,"code":%s,"enabled":1}\n' "$ok" "$rc"
    ;;

  disable)
    out=$("$CTL" disable 2>&1); rc=$?
    if [ $rc -eq 0 ]; then ok=true; else ok=false; fi
    printf '{"ok":%s,"code":%s,"enabled":0}\n' "$ok" "$rc"
    ;;

  apply)
    out=$("$CTL" apply 2>&1); rc=$?
    if [ $rc -eq 0 ]; then ok=true; else ok=false; fi
    printf '{"ok":%s,"code":%s,"result":"%s"}\n' "$ok" "$rc" "$(clean "$out")"
    ;;

  restoreall)
    out=$("$CTL" restore-all 2>&1); rc=$?
    if [ $rc -eq 0 ]; then ok=true; else ok=false; fi
    printf '{"ok":%s,"code":%s,"result":"%s"}\n' "$ok" "$rc" "$(clean "$out")"
    ;;

  *)
    printf '{"ok":false,"err":"unknown cmd"}\n'
    ;;
esac
