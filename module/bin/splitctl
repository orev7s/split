#!/system/bin/sh
#
# splitctl 2.0.2 -- per-app audio focus policy with a persistent config
#
# WHY 2.0 EXISTS
# --------------
# v1 set TAKE_AUDIO_FOCUS to "ignore" on every installed package and restored
# with "default". On HyperOS "default" does NOT mean stock: the platform rejects
# the focus request and logs
#     AudioHardening focus request ignored ... level: partial
# so v1's revert was a no-op and every app sat in a 5 second rejection loop.
# Measured on device: setting a package to "allow" stopped the loop instantly
# and put the app back in the focus stack with gain=GAIN.
#
# Therefore this module only ever writes two values:
#     allow  -> app takes focus normally, pauses others (stock behaviour)
#     ignore -> app never takes focus, so it plays over others
# "default" is never written. It is the broken state.
#
# WHY 2.0.2 EXISTS
# ----------------
# Everything here used to depend on customize.sh having run exactly once: the
# engine was copied to $DIR/splitctl at install time and never again. A hot
# reinstall runs the OLD uninstall.sh, which deletes $DIR, and then hotinstall.sh
# hit `[ -x "$DIR/splitctl" ] || exit 0` and silently did nothing. The WebUI was
# left calling a binary that no longer existed, so every tap reported "Failed"
# with no explanation.
#
# So the engine can now deploy itself. `provision` is idempotent, and both the
# boot service and the WebUI call it before doing anything else.
#
# STATE
#   /data/adb/split/config.tsv   one "<package><TAB><mode>" per line
#   /data/adb/split/enabled      "1" or "0"
#   /data/adb/split/applied.txt  packages this module has set to ignore

DIR=/data/adb/split
CONF=$DIR/config.tsv
ENABLED=$DIR/enabled
APPLIED=$DIR/applied.txt
LOG=$DIR/split.log

log() { echo "$(date '+%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

valid_pkg() {
  case "$1" in
    ""|*[!A-Za-z0-9._]*) return 1 ;;
    *) return 0 ;;
  esac
}

valid_mode() {
  case "$1" in allow|ignore) return 0 ;; *) return 1 ;; esac
}

ensure() {
  mkdir -p "$DIR" 2>/dev/null
  [ -f "$CONF" ] || : > "$CONF"
  [ -f "$ENABLED" ] || echo 1 > "$ENABLED"
  [ -f "$APPLIED" ] || : > "$APPLIED"
}

is_enabled() { [ "$(cat "$ENABLED" 2>/dev/null)" = "1" ]; }

mode_of() {
  m=$(awk -F'\t' -v p="$1" '$1==p{print $2; exit}' "$CONF" 2>/dev/null)
  [ -n "$m" ] && echo "$m" || echo allow
}

# write one package, recording what we changed so revert is exact
set_one() {
  pkg=$1
  mode=$2
  valid_pkg "$pkg" || return 1
  valid_mode "$mode" || return 1
  cmd appops set "$pkg" TAKE_AUDIO_FOCUS "$mode" >/dev/null 2>&1 || return 1
  return 0
}

# ------------------------------------------------------------- provision
# Idempotent self-deployment. Safe to call from service.sh, hotinstall.sh,
# customize.sh, or the WebUI before any other subcommand. This is what makes a
# wiped or half-installed $DIR recoverable instead of permanently broken.
provision() {
  ensure

  self=$0
  case "$self" in
    /*) ;;
    *) self=$(command -v "$self" 2>/dev/null || echo "$self") ;;
  esac

  if [ ! -x "$DIR/splitctl" ] && [ -f "$self" ]; then
    cp -f "$self" "$DIR/splitctl" 2>/dev/null && chmod 0755 "$DIR/splitctl" 2>/dev/null
  fi

  if [ -x "$DIR/splitctl" ]; then
    log "provision: ok"
    echo "provisioned"
    return 0
  fi

  log "provision: no engine at $DIR/splitctl (self=$self)"
  echo "provision failed: cannot deploy engine from '$self'" >&2
  return 1
}

# ---------------------------------------------------------------- apply
apply() {
  ensure
  if ! is_enabled; then
    restore
    return 0
  fi
  n_ig=0
  n_al=0
  n_bad=0
  : > "$APPLIED.new"
  while IFS=$(printf '\t') read -r pkg mode; do
    [ -n "$pkg" ] || continue
    case "$pkg" in \#*) continue ;; esac
    valid_mode "$mode" || continue
    if set_one "$pkg" "$mode"; then
      if [ "$mode" = "ignore" ]; then
        echo "$pkg" >> "$APPLIED.new"
        n_ig=$((n_ig+1))
      else
        n_al=$((n_al+1))
      fi
    else
      n_bad=$((n_bad+1))
      log "apply: failed $pkg ($mode)"
    fi
  done < "$CONF"
  mv -f "$APPLIED.new" "$APPLIED" 2>/dev/null
  log "apply: $n_ig ignore, $n_al allow, $n_bad failed"
  echo "applied: $n_ig ignore, $n_al allow, $n_bad failed"
  return 0
}

# -------------------------------------------------------------- restore
# Revert everything this module ever touched back to working focus.
# "allow", never "default".
restore() {
  ensure
  n=0
  if [ -f "$APPLIED" ]; then
    while read -r pkg; do
      [ -n "$pkg" ] || continue
      valid_pkg "$pkg" || continue
      cmd appops set "$pkg" TAKE_AUDIO_FOCUS allow >/dev/null 2>&1 && n=$((n+1))
    done < "$APPLIED"
    : > "$APPLIED"
  fi
  # also clear any config entry that is not ignore, so nothing is left half set
  while IFS=$(printf '\t') read -r pkg mode; do
    [ -n "$pkg" ] || continue
    case "$pkg" in \#*) continue ;; esac
    [ "$mode" = "ignore" ] || continue
    valid_pkg "$pkg" || continue
    cmd appops set "$pkg" TAKE_AUDIO_FOCUS allow >/dev/null 2>&1 && n=$((n+1))
  done < "$CONF" 2>/dev/null
  log "restore: $n packages set to allow"
  echo "restored: $n"
}

# Nuclear option: every installed package to allow. Slow (~447 appops writes)
# but it guarantees no residue from v1 or from anything else.
restore_all() {
  n=0
  for p in $(pm list packages 2>/dev/null | sed 's/^package://'); do
    cmd appops set "$p" TAKE_AUDIO_FOCUS allow >/dev/null 2>&1 && n=$((n+1))
  done
  : > "$APPLIED" 2>/dev/null
  log "restore-all: $n"
  echo "restored all: $n"
}

# ----------------------------------------------------------------- set
# Apply first, persist second. Config must never claim something appops
# rejected, and the exit code has to be honest so the WebUI can say why.
setcmd() {
  ensure
  pkg=$1
  mode=$2
  valid_pkg "$pkg" || { echo "bad package: '$pkg'" >&2; return 2; }
  valid_mode "$mode" || { echo "bad mode: '$mode'" >&2; return 2; }

  if is_enabled; then
    if ! set_one "$pkg" "$mode"; then
      log "set: appops rejected $pkg -> $mode"
      echo "appops rejected $pkg -> $mode (is the package installed?)" >&2
      return 1
    fi
  fi

  awk -F'\t' -v p="$pkg" '$1!=p' "$CONF" > "$CONF.tmp" 2>/dev/null
  if [ "$mode" = "ignore" ]; then
    printf '%s\t%s\n' "$pkg" "$mode" >> "$CONF.tmp"
  fi
  mv -f "$CONF.tmp" "$CONF"

  if [ "$mode" = "ignore" ]; then
    grep -qx "$pkg" "$APPLIED" 2>/dev/null || echo "$pkg" >> "$APPLIED"
  else
    grep -vx "$pkg" "$APPLIED" > "$APPLIED.tmp" 2>/dev/null
    mv -f "$APPLIED.tmp" "$APPLIED" 2>/dev/null
  fi

  echo "$pkg -> $mode"
  return 0
}

enable()  { ensure; echo 1 > "$ENABLED"; apply; }
disable() { ensure; echo 0 > "$ENABLED"; restore; }

status() {
  ensure
  e=$(cat "$ENABLED" 2>/dev/null)
  echo "enabled: $e"
  echo "engine:  $([ -x "$DIR/splitctl" ] && echo present || echo MISSING)"
  echo "rules:   $(grep -c . "$CONF" 2>/dev/null || echo 0)"
  echo "applied: $(grep -c . "$APPLIED" 2>/dev/null || echo 0)"
  echo "--- samples ---"
  for p in com.spotify.music com.supercell.brawlstars com.google.android.youtube; do
    printf '%-32s %s\n' "$p" "$(cmd appops get "$p" TAKE_AUDIO_FOCUS 2>/dev/null | head -n1)"
  done
  echo "--- hardening blocks (should be old or absent) ---"
  dumpsys audio 2>/dev/null | grep "AudioHardening" | tail -2
  echo "now: $(date '+%m-%d %H:%M:%S')"
}

# ----------------------------------------------------------------- serve
# Optional HTTP UI. KernelSU's WebUI button does not need it; this is for
# opening the panel from a desktop browser. Picks the first free port instead
# of assuming 8080 is available.
serve() {
  ensure
  BB=""
  for c in /data/adb/ksu/bin/busybox /data/adb/magisk/busybox /system/bin/busybox; do
    [ -x "$c" ] && { BB="$c"; break; }
  done
  [ -n "$BB" ] || BB=$(command -v busybox 2>/dev/null)
  [ -n "$BB" ] || { echo "no busybox"; return 1; }

  BIND=$(cat "$DIR/bind" 2>/dev/null)
  [ -n "$BIND" ] || BIND=0.0.0.0

  pkill -f "httpd.*split/www" 2>/dev/null
  sleep 1

  port_busy() { $BB netstat -ltn 2>/dev/null | grep -q ":$1 "; }
  try_port() {
    port_busy "$1" && return 1
    $BB httpd -p "$BIND:$1" -h "$DIR/www" >/dev/null 2>&1
    sleep 1
    port_busy "$1"
  }

  SAVED=$(cat "$DIR/port" 2>/dev/null)
  for p in "$SAVED" 8080 8081 8082 8083 8084 8085 8086 8087 8088 8089 8090 8091 8092; do
    [ -n "$p" ] || continue
    if try_port "$p"; then
      echo "$p" > "$DIR/port"
      echo "serving on $BIND:$p"
      return 0
    fi
  done
  echo "no free port"
  return 1
}

case "$1" in
  provision)   provision ;;
  serve)       serve ;;
  apply)       apply ;;
  restore)     restore ;;
  restore-all) restore_all ;;
  set)         setcmd "$2" "$3" ;;
  enable)      enable ;;
  disable)     disable ;;
  status)      status ;;
  *) echo "usage: splitctl provision|apply|restore|restore-all|set <pkg> <allow|ignore>|enable|disable|serve|status" ;;
esac
